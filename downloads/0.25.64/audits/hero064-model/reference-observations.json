  "observations": {
    "fresh": "Paired white-root low draping flaps turn down/back around upper rear skull; pale-yellow halo. This is not HeroNormal upright stalk construction.",
    "balanced": "Short shallow outward/down flaps have yellow shoulder and teal terminal; small blue-violet/cream lobed wings.",
    "run": "Long narrow side flaps end near lower cheek and sweep down/forward in side view.",
    "power": "White V roots carry broad thick mint paddles up/back with blunt yellow ends.",
    "fly": "Opposite Fly training leaves firstSwim selected; terminal outer fins rise up/back, lime shoulders/green distal, small gold winglets.",
    "swim": "Long narrow paired streamers descend back past head sides, mint proximal/violet distal; wings flatten.",
    "run_fly": "Moderate short downward arches with small upturned terminal nib; authored two-box approximation omits this tiny separate upturn.",
    "run_swim": "Nearly vertical long side flaps, shorter than pureSwim, intermediate colors.",
    "power_fly": "Broad near-horizontal paddles with slightly raised outer ends; not simply Fly recolored.",
    "power_swim": "Moderate outward/down arches, tan terminal, side back/down; shorter than pureSwim."
  },
  "explicit_approximations": [
    "Four closed head boxes retain two main sections per side; rounded arches, sharp source terminal tapers and the tiny Run+Fly upturned nib are simplified.",
    "Swim and Run long flaps use simple cuboid streamers; webbed feet stay compact blocks.",
    "Wing lobes are small positive-thickness cuboids, not smooth teardrops.",
    "Four-bar square halo follows original marker tilt; original firstbarUV island retained.",
    "Current source colors and shape interpolation timing are authored rather than a copied source-game formula."
  ],
